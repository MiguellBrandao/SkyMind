{
  "name": "skymind",
  "version": "0.1.0",
  "description": "SkyMind - an AI assistant Discord bot exclusively specialized in Hypixel SkyBlock",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:migrate:prod": "node dist/src/database/migrate.js",
    "db:studio": "drizzle-kit studio",
    "deploy:commands": "tsx src/bot/deploy-commands.ts",
    "deploy:commands:prod": "node dist/src/bot/deploy-commands.js",
    "knowledge:sync": "tsx scripts/knowledge-sync.ts",
    "knowledge:sync:prod": "node dist/scripts/knowledge-sync.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@google/generative-ai": "^0.21.0",
    "cheerio": "^1.0.0",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.36.4",
    "fastify": "^5.1.0",
    "ioredis": "^5.4.1",
    "openai": "^4.73.0",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "prismarine-nbt": "^2.7.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.3",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}

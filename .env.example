# ==================================================
# Discord
# ==================================================
# Bot token from https://discord.com/developers/applications -> Bot -> Token
DISCORD_BOT_TOKEN=
# Application (client) ID from the "General Information" page
DISCORD_CLIENT_ID=
# Client secret (only needed if you enable the optional web OAuth callback)
DISCORD_CLIENT_SECRET=
# Guild ID to register slash commands to instantly during development.
# Leave empty to register commands globally (can take up to 1 hour to propagate).
DISCORD_DEV_GUILD_ID=
# Comma-separated Discord user IDs allowed to use /admin commands
DISCORD_ADMIN_USER_IDS=

# ==================================================
# Hypixel API
# ==================================================
# Generate at https://developer.hypixel.net/dashboard
HYPIXEL_API_KEY=
# Max concurrent requests SkyMind is allowed to make to the Hypixel API at once
HYPIXEL_MAX_CONCURRENCY=4
# Max requests per minute SkyMind will self-throttle to (Hypixel's default key limit is 300/min)
HYPIXEL_RATE_LIMIT_PER_MINUTE=280

# ==================================================
# Database (PostgreSQL + pgvector)
# ==================================================
DATABASE_URL=postgresql://skymind:skymind@localhost:5432/skymind

# ==================================================
# Redis
# ==================================================
REDIS_URL=redis://localhost:6379

# ==================================================
# Security
# ==================================================
# 32-byte key (64 hex chars) used to encrypt user-provided AI API keys at rest.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# ==================================================
# AI Providers
# ==================================================
DEFAULT_AI_PROVIDER=gemini
DEFAULT_AI_MODEL=gemini-2.5-flash
DEFAULT_AI_API_KEY=

# Optional: only needed if you want the app's default provider to be OpenAI/Anthropic/custom instead
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Embedding model used for the SkyBlock knowledge base (RAG). Must match EMBEDDING_DIMENSIONS.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSIONS=768

# ==================================================
# Cache TTLs (seconds) - all configurable, sensible defaults shown
# ==================================================
CACHE_TTL_PLAYER=900
CACHE_TTL_PROFILES=180
CACHE_TTL_PROFILE=180
CACHE_TTL_BAZAAR=45
CACHE_TTL_AUCTIONS=120
CACHE_TTL_STATIC=86400

# ==================================================
# API server (Fastify) - health checks + optional admin/OAuth endpoints
# ==================================================
API_PORT=3000
API_HOST=0.0.0.0
# Bearer token required to call internal /admin/* HTTP endpoints
ADMIN_API_TOKEN=

# ==================================================
# Misc
# ==================================================
NODE_ENV=development
LOG_LEVEL=info
